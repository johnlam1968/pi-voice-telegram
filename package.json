{
  "name": "pi-voice-telegram",
  "version": "0.16.4",
  "description": "Telegram voice/text companion extension for the Pi coding agent. Registers a TTS synthesis provider (mm-tts-backed by default) and a voice transcript echo for incoming voice/audio messages. Behavior is fully driven by the bridge's telegram.json config (voice.replyMode, voice.sendTranscript, etc.).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "John Lam",
    "email": "jwebster@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnlam1968/pi-voice-telegram.git"
  },
  "homepage": "https://github.com/johnlam1968/pi-voice-telegram#readme",
  "bugs": {
    "url": "https://github.com/johnlam1968/pi-voice-telegram/issues"
  },
  "keywords": [
    "pi-extension",
    "telegram",
    "tts",
    "stt",
    "voice",
    "transcript",
    "echo",
    "mm-tts",
    "whisper"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@llblab/pi-telegram": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@llblab/pi-telegram": {
      "optional": false
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "*.ts",
    "pi-voice-telegram.schema.json",
    "voices.json",
    "package.json",
    "README.md",
    "PLAN.md",
    "examples/",
    "LICENSE"
  ]
}
